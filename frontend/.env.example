# Left unset for local dev — the Vite dev-server proxy (vite.config.ts)
# forwards /api/* to the backend on http://127.0.0.1:8000, so no CORS
# config is needed on the backend for local development.
#
# Set only in production (Render static site env var), to the deployed
# backend's base URL, e.g. https://interview-ai-agent-backend.onrender.com
VITE_API_BASE_URL=

# Google OAuth client ID .  Must match the backend's GOOGLE_OAUTH_CLIENT_ID exactly.
# so a mismatch here just makes every real Google sign-in fail with 401.
VITE_GOOGLE_CLIENT_ID=


# Must match the backend's REQUEST_ID_SECRET.
# Backend requires this in the X-Request-ID header for frontend requests.
# This is not authentication and must not be used as a security secret.
VITE_REQUEST_ID_SECRET=

# Left unset for local dev — the Vite dev-server proxy (vite.config.ts)
# forwards /api/* to the backend on http://127.0.0.1:8000, so no CORS
# config is needed on the backend for local development.
#
# Set only in production (Render static site env var), to the deployed
# backend's base URL, e.g. https://interview-ai-agent-backend.onrender.com
VITE_API_BASE_URL=

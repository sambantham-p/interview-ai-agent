# Copy to .env and fill in real values locally. Never commit .env itself

# Postgres (Neon) — connection string from your Neon project dashboard
DATABASE_URL=

# Gemini — used by the LLM Gateway for all agent calls (Interviewer,
# Judges, extraction). Switched from OpenAI (see CLAUDE.md's Confirmed
# decisions) because credits were available on Gemini, not OpenAI.
GEMINI_API_KEY=

# Model for POST /resume/upload's native-PDF structured-output call (via
# generate_content - see CLAUDE.md's LLM Gateway section). No default in
# code - set explicitly. gemini-3.8-flash: accurate enough for
# multi-column layouts, cheaper/faster than gemini-3.1-pro (frontier
# reasoning, not needed for extraction).
GEMINI_RESUME_PARSING_MODEL=gemini-3.8-flash

# Model for POST /jd's structured-output extraction call (role title,
# seniority, tech stack, coding_assessment_expected). Same tier as resume
# parsing, same reasoning: low-volume but foundational, since it drives
# difficulty calibration and RAG matching for the whole interview.
GEMINI_JD_PARSING_MODEL=gemini-3.8-flash

# Model for the Conversational Interviewer agent . One model
# for every phase of interview; swapping
GEMINI_INTERVIEWER_MODEL=gemini-3.8-flash

# Model for the 5 post-hoc Judge agents (Project-Depth, Coding,
# Fundamentals, Attitude/Communication, Career-Fit).
GEMINI_JUDGE_MODEL=gemini-3.1-pro-preview

# ElevenLabs — text-to-speech for the Interviewer's voice output
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# X-Request-ID gate
REQUEST_ID_SECRET=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=10080

GOOGLE_OAUTH_CLIENT_ID=

# SMTP - outbound verification email for /auth/register.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@prepwise.ai

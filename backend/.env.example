# Copy to .env and fill in real values locally. Never commit .env itself
# (already gitignored via the root .gitignore's "# Environments" section).

# Postgres (Neon) — connection string from your Neon project dashboard
DATABASE_URL=

# Gemini — used by the LLM Gateway for all agent calls (Interviewer,
# Judges, extraction). Switched from OpenAI (see CLAUDE.md's Confirmed
# decisions) because credits were available on Gemini, not OpenAI.
GEMINI_API_KEY=

# Model used for POST /resume/upload's native-PDF structured-output call
# (via client.aio.interactions.create() - the Interactions API, not the
# legacy generate_content). No default baked into code —
# set explicitly. Recommended: gemini-3.8-flash, not the cheaper
# gemini-3.5-flash-lite (despite Flash-Lite being marketed for
# high-volume/routine work): this call is low-volume (once per resume)
# but foundational — a bad extraction here (misread multi-column layout,
# merged entries) corrupts Phase 1/2's data for the whole interview, so
# accuracy matters more than the negligible cost saving at this call
# volume. Not gemini-3.1-pro either — that tier is for frontier reasoning,
# not structured extraction; its extra cost/latency buys nothing here.
# (POST /jd's model choice is a separate decision, made when that
# endpoint is actually built.)
GEMINI_RESUME_PARSING_MODEL=gemini-3.8-flash

# ElevenLabs — text-to-speech for the Interviewer's voice output
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Judge0 CE via RapidAPI — code execution for the coding challenge phase
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# GitHub — optional, raises API rate limits for GitHub enrichment (works
# unauthenticated too, just at a lower rate limit)
GITHUB_TOKEN=
